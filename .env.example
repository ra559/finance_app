# ─────────────────────────────────────────────────────────────
# Cove configuration. Copy to .env and edit.
# .env is read automatically when the server starts (Node 20.6+).
# ─────────────────────────────────────────────────────────────

# Public URL of your instance. Used for Plaid's redirect back to the app.
APP_URL=http://localhost:3000

# Port inside the container / on the host.
PORT=3000

# Bind address. Use 127.0.0.1 when a Cloudflare Tunnel or local reverse
# proxy is the only thing that should reach Cove.
HOST=0.0.0.0

# Host port used by docker-compose.yml. Prefix with 127.0.0.1: to keep
# the app off the public interface (e.g. COVE_PORT=127.0.0.1:3000).
COVE_PORT=3000

# Where the SQLite database and generated secret live.
# In Docker this is always /data (set by the image/compose file).
DATA_DIR=./data

# Optional timezone for logs and background jobs (e.g. America/New_York).
TZ=UTC

# Set to 1 when running behind Cloudflare Tunnel, nginx, Caddy or any
# reverse proxy so secure cookies and client IPs are detected correctly.
TRUST_PROXY=1

# Optional: a 64-character hex key used to encrypt bank tokens and API keys
# at rest. If unset, Cove generates one in DATA_DIR/secret.key automatically.
# APP_SECRET=

# ── Bank sync (Plaid) ───────────────────────────────────────
# Create an account at https://dashboard.plaid.com and copy your keys.
# Leave blank to use CSV / OFX / QFX import only.
PLAID_CLIENT_ID=
# One secret per environment. Sandbox secrets start with "sandbox-".
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=sandbox
# Optional comma-separated country codes for Link.
PLAID_COUNTRY_CODES=US,CA
# Optional: also sync investment holdings from Plaid (default true).
PLAID_INVESTMENTS=true
# Background sync interval in hours. 0 disables the scheduler.
SYNC_INTERVAL_HOURS=6

# ── AI assistant (optional) ─────────────────────────────────
# Any OpenAI-compatible /chat/completions endpoint works.
# These environment values override the values saved in the UI.
# OpenAI:      https://api.openai.com/v1        gpt-4.1-mini
# Ollama:      http://host.docker.internal:11434/v1   llama3.1
# OpenRouter:  https://openrouter.ai/api/v1      anthropic/claude-sonnet-4
# LM Studio:   http://host.docker.internal:1234/v1   local-model
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=

# ── Cloudflare Tunnel (optional) ────────────────────────────
# Create a tunnel in Zero Trust → Networks → Tunnels, then paste the
# connector token here and start: docker compose --profile tunnel up -d
# CLOUDFLARE_TUNNEL_TOKEN=
